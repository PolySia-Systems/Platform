[Unit]
Description=PolySia daily wallet-intelligence candidate pipeline
Documentation=/opt/polysia/docs/10-operations/wallet-intelligence-ingestion.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/polysia
ExecStart=/usr/bin/docker compose --profile wallet-intelligence run --rm wallet-intelligence-sync
TimeoutStartSec=30min
NoNewPrivileges=true
