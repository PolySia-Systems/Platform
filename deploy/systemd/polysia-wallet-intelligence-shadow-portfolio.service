[Unit]
Description=PolySia persistent continuous all-market Shadow portfolio worker
Documentation=file:/opt/polysia/docs/10-operations/wallet-intelligence-ingestion.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=on-failure
RestartSec=20
WorkingDirectory=/opt/polysia
ExecStartPre=-/usr/bin/docker compose --profile wallet-intelligence rm -fs --timeout 30 wallet-intelligence-shadow-portfolio
ExecStart=/usr/bin/docker compose --profile wallet-intelligence up --abort-on-container-exit --no-color --no-deps wallet-intelligence-shadow-portfolio
ExecStop=/usr/bin/docker compose --profile wallet-intelligence stop --timeout 90 wallet-intelligence-shadow-portfolio
TimeoutStartSec=0
TimeoutStopSec=2min
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
