# Copy this file to /etc/polysia/polysia.env and set mode 0600.
# Never commit the populated server file.
APP_ENV=production
TRADING_MODE=DATA_ONLY
LIVE_TRADING_ENABLED=false
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_LIVE_TOKEN_ALLOWLIST=
POLYMARKET_LIVE_MAX_ORDER_SIZE=1
POLYMARKET_LIVE_MAX_ORDER_NOTIONAL=1
POLYMARKET_LIVE_MAX_OPEN_ORDERS=1
POLYMARKET_READ_MAX_ATTEMPTS=2
POLYMARKET_READ_BACKOFF_SECONDS=0.25
POLYMARKET_SERVER_TIME_TIMEOUT_SECONDS=5
POLYMARKET_MAX_CLOCK_DRIFT_SECONDS=5
LOG_LEVEL=INFO
POLYSIA_MONITOR_INTERVAL_SECONDS=60
POLYSIA_RECONCILIATION_EVERY_CYCLES=15
POLYSIA_CONTINUOUS_SHADOW_POLL_SECONDS=60
POLYSIA_CONTINUOUS_SHADOW_WALLET_BANKROLL=100
POLYSIA_CONTINUOUS_SHADOW_FOLLOWER_BANKROLL=1000
POLYSIA_CONTINUOUS_SHADOW_MAX_EVENT_NOTIONAL=5
POLYSIA_CONTINUOUS_SHADOW_WALLET_MAX_EXPOSURE=100
POLYSIA_CONTINUOUS_SHADOW_FOLLOWER_MAX_EXPOSURE=500
POLYSIA_CONTINUOUS_SHADOW_FOLLOWER_WALLET_MAX_EXPOSURE=25
POLYSIA_CONTINUOUS_SHADOW_FOLLOWER_MARKET_MAX_EXPOSURE=100
POLYSIA_CONTINUOUS_SHADOW_FOLLOWER_MAX_POSITIONS=100
POLYSIA_CONTINUOUS_SHADOW_MAX_DELAY_MS=300000
POLYSIA_CONTINUOUS_SHADOW_MAX_QUOTE_AGE_MS=30000
POLYSIA_CONTINUOUS_SHADOW_INITIAL_LOOKBACK_MINUTES=15
POLYSIA_CONTINUOUS_SHADOW_OVERLAP_SECONDS=30
