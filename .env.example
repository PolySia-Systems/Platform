APP_ENV=development
TRADING_MODE=DATA_ONLY
LIVE_TRADING_ENABLED=false
POLYSIA_COPY_SIGNAL_ARBITER_FULL_ENABLED=false
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=3
# Deprecated compatibility input; prefer POLYMARKET_FUNDER_ADDRESS.
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_LIVE_TOKEN_ALLOWLIST=
POLYMARKET_LIVE_MAX_ORDER_SIZE=1
POLYMARKET_LIVE_MAX_ORDER_NOTIONAL=1
POLYMARKET_LIVE_MAX_OPEN_ORDERS=1
POLYMARKET_READ_MAX_ATTEMPTS=2
POLYMARKET_READ_BACKOFF_SECONDS=0.25
POLYMARKET_SERVER_TIME_TIMEOUT_SECONDS=5
POLYMARKET_MAX_CLOCK_DRIFT_SECONDS=5
LOG_LEVEL=INFO
POLYSIA_CONTINUOUS_SHADOW_POLL_SECONDS=60
POLYSIA_CONTINUOUS_SHADOW_WALLET_BANKROLL=100
POLYSIA_CONTINUOUS_SHADOW_FOLLOWER_BANKROLL=1000
POLYSIA_CONTINUOUS_SHADOW_MAX_EVENT_NOTIONAL=5
POLYSIA_HOST_ID=
POLYSIA_PROVIDER=
POLYSIA_REGION=
POLYSIA_LATENCY_TELEMETRY_ENABLED=true
POLYSIA_LATENCY_PROBE_ENABLED=true
